<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="525.0" prefWidth="752.0" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/17.0.15"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.pi_dev.Controllers.GestionCoursController">

    <!-- Sidebar identique à template.fxml -->
    <left>
        <VBox fx:id="ap" prefHeight="526.0" prefWidth="240.0" style="-fx-background-color: #8ECAE6;" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="homeButton" mnemonicParsing="false" onAction="#retourHome" prefHeight="58.0" prefWidth="238.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 0px 0px 2px 0px;" text="Home" textFill="WHITE">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" prefHeight="58.0" prefWidth="240.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 0px 0px 2px 0px;" text="Gestion des Utilisateurs" textFill="WHITE">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
                <Button layoutX="10.0" layoutY="68.0" mnemonicParsing="false" prefHeight="58.0" prefWidth="244.0" style="-fx-background-color: #219EBC; -fx-border-color: white; -fx-border-width: 0px 0px 2px 0px;" text="Gestion des Cours " textFill="WHITE">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
                <!-- Les autres boutons restent identiques à template.fxml -->
                <Button layoutX="10.0" layoutY="127.0" mnemonicParsing="false" prefHeight="58.0" prefWidth="242.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 0px 0px 2px 0px;" text="Gestion des Salles " textFill="WHITE">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
                <Button layoutX="10.0" layoutY="185.0" mnemonicParsing="false" prefHeight="58.0" prefWidth="244.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 0px 0px 2px 0px;" text="Gestion des Événements" textFill="WHITE">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
                <Button layoutX="10.0" layoutY="244.0" mnemonicParsing="false" prefHeight="58.0" prefWidth="242.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 0px 0px 2px 0px;" text="Gestion des Paiements" textFill="WHITE">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
                <Button layoutX="10.0" layoutY="302.0" mnemonicParsing="false" prefHeight="58.0" prefWidth="240.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 0px 0px 2px 0px;" text="Gestion des Performances " textFill="WHITE">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
                <Button layoutX="10.0" layoutY="360.0" mnemonicParsing="false" prefHeight="58.0" prefWidth="242.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 0px 0px 2px 0px;" text="Gestion des Ressources " textFill="WHITE">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
                <Button layoutX="10.0" layoutY="419.0" mnemonicParsing="false" prefHeight="58.0" prefWidth="238.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-width: 0px 0px 2px 0px;" text="Déconnexion" textFill="WHITE">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </left>

    <!-- Centre : Contenu principal -->
    <center>
        <VBox spacing="10" style="-fx-padding: 15px;">
            <!-- En-tête -->
            <HBox style="-fx-background-color: #219EBC; -fx-padding: 15px;">
                <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Gestion des Cours et Sessions">
                    <font><Font size="20" /></font>
                </Label>
            </HBox>

            <!-- Boutons de contrôle d'affichage -->
            <HBox spacing="10" style="-fx-padding: 10px;">
                <Button fx:id="afficherCoursBtn" onAction="#afficherTableCours" style="-fx-background-color: #219EBC; -fx-text-fill: white; -fx-font-weight: bold;" text="Afficher Cours" />
                <Button fx:id="afficherSessionsBtn" onAction="#afficherTableSessions" style="-fx-background-color: #219EBC; -fx-text-fill: white; -fx-font-weight: bold;" text="Afficher Sessions" />
            </HBox>

            <!-- Boutons d'actions -->
            <HBox fx:id="coursButtonsContainer" spacing="10" >
            <!-- Boutons Cours -->
                <Button fx:id="ajouterCoursBtn"  onAction="#handleAjouterCours" style="-fx-background-color: #219EBC; -fx-text-fill: white;" text="Ajouter Cours" />
                <Button fx:id="modifierCoursBtn"  onAction="#handleModifierCours" style="-fx-background-color: #219EBC; -fx-text-fill: white;" text="Modifier Cours" />
                <Button fx:id="supprimerCoursBtn"  onAction="#handleSupprimerCours" style="-fx-background-color: #219EBC; -fx-text-fill: white;" text="Supprimer Cours" />
            </HBox>

            <HBox fx:id="sessionsButtonsContainer" spacing="10" visible="false">
                <!-- Boutons Session -->
                <Button fx:id="ajouterSessionBtn"  onAction="#handleAjouterSession" style="-fx-background-color: #219EBC; -fx-text-fill: white;" text="Ajouter Session" />
                <Button fx:id="modifierSessionBtn" onAction="#handleModifierSession" style="-fx-background-color: #219EBC; -fx-text-fill: white;" text="Modifier Session" />
                <Button fx:id="supprimerSessionBtn"  onAction="#handleSupprimerSession" style="-fx-background-color: #219EBC; -fx-text-fill: white;" text="Supprimer Session" />
            </HBox>

             <HBox fx:id="metierButtonsContainer" spacing="10">
                <Button fx:id="metierAvancee1Btn" disable="true" onAction="#handleMetierAvancee1" style="-fx-background-color: #219EBC; -fx-text-fill: white;" text="Métier Avancee" />
                <Button fx:id="metierAvancee2Btn" disable="true" onAction="#handleMetierAvancee2" style="-fx-background-color: #219EBC; -fx-text-fill: white;" text="Métier Avancee" />
            </HBox>

            <!-- Conteneur pour les tables (StackPane permet de superposer les éléments) -->
            <StackPane>
                <!-- Table Cours (visible par défaut) -->
                <TableView fx:id="tableCours" visible="true">
                    <columns>
                        <TableColumn fx:id="idCoursCol" text="ID" />
                        <TableColumn fx:id="nomCoursCol" text="Nom" />
                        <TableColumn fx:id="descriptionCol" text="Description" />
                        <TableColumn fx:id="dureeCol" text="Durée (h)" />
                        <TableColumn fx:id="prixCol" text="Prix (€)" />
                        <TableColumn fx:id="categorieCol" text="Catégorie" />
                    </columns>
                </TableView>

                <!-- Table Sessions (cachée par défaut) -->
                <TableView fx:id="tableSessionCours" visible="false">
                    <columns>
                        <TableColumn fx:id="idSessionCol" text="ID" />
                        <TableColumn fx:id="nomSessionCol" text="Nom Session" />
                        <TableColumn fx:id="dateDebutCol" text="Date Début" />
                        <TableColumn fx:id="dateFinCol" text="Date Fin" />
                        <TableColumn fx:id="coursSessionCol" text="Cours Associé" />
                        <TableColumn fx:id="descriptionCoursCol" text="Description Cours" />
                    </columns>
                </TableView>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
